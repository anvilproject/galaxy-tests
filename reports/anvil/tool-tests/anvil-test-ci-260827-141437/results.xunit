            import anndata as ad        import pandas as pdadata = ad.read_mtx(filename='/galaxy/server/database/files/000/dataset_777.dat')adata = adata.transpose().copy()obs = pd.read_csv('/galaxy/server/database/files/000/dataset_779.dat', sep='\t', index_col=0)var = pd.read_csv('/galaxy/server/database/files/000/dataset_781.dat', sep='\t', index_col=0)if adata.shape[0] != obs.shape[0]:    raise ValueError(f"Mismatch: adata has {adata.shape[0]} cells, but obs has {obs.shape[0]} rows.")if adata.shape[1] != var.shape[0]:    raise ValueError(f"Mismatch: adata has {adata.shape[1]} genes, but var has {var.shape[0]} rows.")adata.obs = obsadata.var = varadata.write('anndata.h5ad', compression='gzip')print(adata)AnnData object with n_obs × n_vars = 1000 × 500    var: 'symbol', 'mito'
            ]]></system-out>
