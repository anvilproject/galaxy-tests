    <testcase classname="toolshed.g2.bx.psu.edu/repos/iuc/ggplot2_heatmap/ggplot2_heatmap (Test #1)" name="0" time="106.36735558509827">
        
            
            <system-out><![CDATA[
                    options(show.error.messages=F, error=function(){cat(geterrmessage(), file=stderr()); q("no",1,F)})        loc <- Sys.setlocale("LC_MESSAGES", "en_US.UTF-8")    library(ggplot2)library(cowplot)library(egg)library(dplyr)library(ggdendro)library(reshape2)input <- '/galaxy/server/database/files/000/dataset_329.dat'header <- TRUErowname_index <- as.integer('1')transform <- 'log10plus1'if(rowname_index > 0){    df <- read.table(input, header = header, row.names = rowname_index, sep = "\t")}else{    df <- read.table(input, header = header, sep = "\t")}hclust_fun = function(x) hclust(x, method="complete")dist_fun = function(x) dist(x, method="maximum")distfun=dist_funhclustfun=hclust_funplot_mat <- dfif(transform == "log2"){    plot_mat <- log2(plot_mat)    cat("\n ", transform, " transformed")}else if(transform == "log2plus1"){    plot_mat <- log2(plot_mat+1)    cat("\n ", transform, " transformed")}else if(transform == "log10"){    plot_mat <- log10(plot_mat)    cat("\n ", transform, " transformed")}else if(transform == "log10plus1"){    plot_mat <- log10(plot_mat+1)    cat("\n ", transform, " transformed")}else{    plot_mat <- plot_mat}    colorscale = scale_fill_gradient2(low="blue", mid="white", high="red", guide="colorbar")plot_mat["rows"] <- row.names(plot_mat)plot_mat.melt <- melt(plot_mat, id.vars = "rows")names(plot_mat.melt)[2] <- "cols"plot_mat.dendo <- as.dendrogram(hclust(d = dist(x = subset(plot_mat, select = -rows))))plot_mat.dendo.order <- order.dendrogram(plot_mat.dendo)gg_rows = ggdendrogram(data = plot_mat.dendo, rotate = FALSE) +    theme(axis.text.y = element_text(size = 6), axis.text.x = element_blank())plot_mat.melt[,"rows"] <- factor(x = plot_mat.melt[,"rows"],       levels = unique(plot_mat.melt[,"rows"])[plot_mat.dendo.order],       ordered = TRUE)plot_mat.dendo <- as.dendrogram(hclust(d = dist(x = t(subset(plot_mat, select = -rows)))))plot_mat.dendo.order <- order.dendrogram(plot_mat.dendo)gg_cols = ggdendrogram(data = plot_mat.dendo, rotate = TRUE) +    theme(axis.text.x = element_text(size = 6), axis.text.y = element_blank())plot_mat.melt[,"cols"] <- factor(x = plot_mat.melt[,"cols"],                     levels = unique(plot_mat.melt[,"cols"])[plot_mat.dendo.order],                     ordered = TRUE)gg_hm = plot_mat.melt %>%  ggplot(aes(x = rows, y = cols, fill = value)) +  geom_tile() +  theme(legend.position = "bottom", axis.title.x = element_blank(), axis.title.y = element_blank(),        axis.text.x = element_text(angle = 90, hjust = 1)) +  colorscalegg_empty = plot_mat.melt %>%    ggplot(aes(x = cols, y = value)) +    geom_blank() +    theme(axis.text = element_blank(),        axis.title = element_blank(),        line = element_blank(),        panel.background = element_blank())plot_out <- ggarrange(    gg_rows, gg_empty, gg_hm, gg_cols,    nrow = 2, ncol = 2, widths = c(3, 1), heights = c(1, 3), newpage =F)        gg_width <- as.double('7.0')        gg_height <- as.double('7.0')        gg_unit <- 'in'        gg_dpi <- as.double('300.0')        gg_add_device <- 'pdf'        output1 <- '/galaxy/server/database/jobs_directory/000/289/outputs/dataset_ce960837-f620-41f2-8abf-c8f071f536ca.dat'        output2 <- '/galaxy/server/database/jobs_directory/000/289/outputs/dataset_6cca4d82-9c78-4a1e-bfbf-27fd400f56ec.dat'        ggsave(filename = output1, plot = plot_out, width = gg_width, height = gg_height, units = gg_unit, dpi = gg_dpi, device = "png")        if(gg_add_device != "none"){          ggsave(filename = output2, plot = plot_out, width = gg_width, height = gg_height, units = gg_unit, dpi = gg_dpi, device = gg_add_device)        }              log10plus1  transformed
            ]]></system-out>
