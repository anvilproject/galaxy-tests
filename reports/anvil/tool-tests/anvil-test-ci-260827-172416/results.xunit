                <error type="error" message="Tool exit code: None"><![CDATA[
                    { "inputs": {  "input|accession": "ERR086330",  "input|input_select": "accession_number" }, "job": {  "command_line": "set -o | grep -q pipefail \u0026\u0026 set -o pipefail;  mkdir -p ~/.ncbi \u0026\u0026 cp \u0027/galaxy/server/database/jobs_directory/000/262/configs/tmp0y39fjsx\u0027 ~/.ncbi/user-settings.mkfg \u0026\u0026   export SRA_PREFETCH_RETRIES=3 \u0026\u0026 export SRA_PREFETCH_ATTEMPT=1 \u0026\u0026   echo \u0027ERR086330\u0027 | sed -r \u0027s/(\\,|\\;|__cn__)/\\n/g\u0027 \u003e accessions \u0026\u0026 for acc in $(cat ./accessions); do ( echo \"Downloading accession: $acc...\" \u0026\u0026  while [ $SRA_PREFETCH_ATTEMPT -le $SRA_PREFETCH_RETRIES ] ; do fasterq-dump \"$acc\" -e ${GALAXY_SLOTS:-1} -t ${TMPDIR} --seq-defline \u0027@$ac.$sn/$ri\u0027 --qual-defline \u0027+\u0027 --split-3 --skip-technical 2\u003e\u00261 | tee -a \u0027/galaxy/server/database/jobs_directory/000/262/outputs/dataset_513602a1-fb51-48b7-9831-2559525a9b9a.dat\u0027; if [ $? == 0 ] \u0026\u0026 [ $(ls *.fastq | wc -l) -ge 1 ]; then break ; else echo \"Prefetch attempt $SRA_PREFETCH_ATTEMPT of $SRA_PREFETCH_RETRIES exited with code $?\" ; SRA_PREFETCH_ATTEMPT=`expr $SRA_PREFETCH_ATTEMPT + 1` ; sleep 1 ; fi ; done \u0026\u0026 mkdir -p output \u0026\u0026 mkdir -p outputOther \u0026\u0026 count=\"$(ls *.fastq | wc -l)\" \u0026\u0026 echo \"There are $count fastq files\" \u0026\u0026 data=($(ls *.fastq)) \u0026\u0026 if [ \"$count\" -eq 1 ]; then pigz -cqp ${GALAXY_SLOTS:-1} \"${data[0]}\" \u003e output/\"${acc}\"__single.fastqsanger.gz \u0026\u0026 rm \"${data[0]}\"; elif [ \"--split-3\" = \"--split-3\" ]; then if [ -e \"${acc}\".fastq ]; then pigz -cqp ${GALAXY_SLOTS:-1} \"${acc}\".fastq \u003e outputOther/\"${acc}\"__single.fastqsanger.gz; fi \u0026\u0026 pigz -cqp ${GALAXY_SLOTS:-1} \"${acc}\"_1.fastq \u003e output/\"${acc}\"_forward.fastqsanger.gz \u0026\u0026 pigz -cqp ${GALAXY_SLOTS:-1} \"${acc}\"_2.fastq \u003e output/\"${acc}\"_reverse.fastqsanger.gz \u0026\u0026 rm \"${acc}\"*.fastq; elif [ \"$count\" -eq 2 ]; then pigz -cqp ${GALAXY_SLOTS:-1} \"${data[0]}\" \u003e output/\"${acc}\"_forward.fastqsanger.gz \u0026\u0026 pigz -cqp ${GALAXY_SLOTS:-1} \"${data[1]}\" \u003e output/\"${acc}\"_reverse.fastqsanger.gz \u0026\u0026 rm \"${data[0]}\" \u0026\u0026 rm \"${data[1]}\"; else for file in ${data[*]}; do pigz -cqp ${GALAXY_SLOTS:-1} \"$file\" \u003e outputOther/\"$file\"sanger.gz \u0026\u0026 rm \"$file\"; done; fi;  ); done; echo \"Done with all accessions.\"",  "command_version": null,  "copied_from_job_id": null,  "create_time": "2026-08-27T17:47:54.333705",  "dependencies": [],  "exit_code": null,  "external_id": "anvil-test-1787852875-0224b8d1-262",  "galaxy_version": "26.1",  "handler": null,  "history_id": "764ebd35d087445a",  "id": "1d8eb52da7cc49ee",  "inputs": {},  "job_messages": null,  "job_metrics": [],  "job_runner_name": null,  "job_stderr": null,  "job_stdout": null,  "model_class": "Job",  "output_collections": {   "list_paired": {    "id": "d300217f06e5f5f6",    "src": "hdca"   },   "output_collection": {    "id": "a99abd4dc479161f",    "src": "hdca"   },   "output_collection_other": {    "id": "0efc62cdce554600",    "src": "hdca"   }  },  "outputs": {   "log": {    "id": "6accdefcd3f09713",    "src": "hda",    "uuid": "513602a1-fb51-48b7-9831-2559525a9b9a"   }  },  "params": {   "__input_ext": "\"input\"",   "adv": "{\"minlen\": \"\", \"seq_defline\": \"@$ac.$sn/$ri\", \"skip_technical\": true, \"split\": \"--split-3\"}",   "chromInfo": "\"/cvmfs/data.galaxyproject.org/managed/len/ucsc/?.len\"",   "dbkey": "\"?\"",   "input": "{\"__current_case__\": 0, \"accession\": \"ERR086330\", \"input_select\": \"accession_number\"}"  },  "state": "ok",  "stderr": "",  "stdout": "",  "tool_id": "toolshed.g2.bx.psu.edu/repos/iuc/sra_tools/fasterq_dump/3.1.1+galaxy1",  "tool_stderr": null,  "tool_stdout": null,  "update_time": "2026-08-27T17:49:38.515662",  "user_email": "default-user@galaxyproject.org",  "user