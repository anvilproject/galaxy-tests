    <testcase classname="toolshed.g2.bx.psu.edu/repos/iuc/ggplot2_pca/ggplot2_pca (Test #1)" name="0" time="91.84509205818176">
        
            
            <system-out><![CDATA[
                    options(show.error.messages=F, error=function(){cat(geterrmessage(), file=stderr()); q("no",1,F)})        loc <- Sys.setlocale("LC_MESSAGES", "en_US.UTF-8")    library(ggfortify)library(scales)groups <- TRUEcircles_boolean <- TRUEgroup_name <- list()group_cols <- list()group_colors <- list()group_feature <- ""group_colors_vector <- ""input <- '/galaxy/server/database/files/000/dataset_466.dat'header <- TRUErowname_index <- as.integer('1')horizontal <- TRUEtransform <- 'none'group_type <- 'define_groups'        group_name <- append(group_name, 'group1')        group_cols <- append(group_cols, '3,4')        group_colors <- append(group_colors, 'none')        group_name <- append(group_name, 'group2')        group_cols <- append(group_cols, '2,5,6,8,9,10,11')        group_colors <- append(group_colors, 'none')group_name <- unlist(group_name)group_cols <- unlist(group_cols)group_colors <- unlist(group_colors)circles <- 'convex'plot_param <- 'label'plot_param_list <- strsplit(x = plot_param, split = ",")plot_options <- c("shape", "label") %in% plot_param_list[[1]]if(rowname_index > 0){    df <- read.table(input, header = header, row.names = rowname_index, sep = "\t")}else{    df <- read.table(input, header = header, sep = "\t")}num_cols <- length(names(df))if(group_type == "define_groups"){    check_col_indices <- as.integer(unlist(strsplit(group_cols, split = ",")))    if(any(check_col_indices > num_cols)){        stop("Error: column indices for grouping are out of range! Check help!")    }}if(any(!sapply(df, is.numeric))){    stop("Error: table contains not only numbers!")}if(length(unique(c(group_name, "no_group"))) != length(c(group_name, "no_group"))){    stop("Error: group_names must be unique: ", paste(group_name, "no_group", collapse = ","), " is not unique!")}if(horizontal){    num_cols <- length(names(df))    group_feature <- rep("no_group", num_cols)}else{    num_rows <- nrow(df)    group_feature <- rep("no_group", num_rows)}default_ggplot_colors <- ""default_ggplot_colors_autoplot <- ""if(group_type == "define_groups"){    color_names <- c(group_name, "no_group")    cat("\ncolor_names: ", color_names)    default_ggplot_colors <- hue_pal()(length(color_names))    names(default_ggplot_colors) <- color_names    cat("\ndefault_ggplot_colors: ", default_ggplot_colors)    names(group_colors) <- group_name    group_colors <- group_colors[group_colors != "none"]    default_ggplot_colors[names(group_colors)] <- group_colors    cat("\ndefault_ggplot_colors: ", default_ggplot_colors)    group_string <- lapply(seq_along(group_name), function(k){        gname <- group_name[k]        gindex <- as.integer(strsplit(group_cols[k], split = ",")[[1]])        gnames <- rep(gname, length(gindex))        names(gindex) <- gnames        gindex    })    group_string <- do.call(c, group_string)    group_feature[group_string] <- names(group_string)    default_ggplot_colors <- default_ggplot_colors[unique(group_feature)]    default_ggplot_colors_autoplot <- default_ggplot_colors[group_feature]    cat("\ndefault_ggplot_colors: ", default_ggplot_colors)}            gg_legend = theme(legend.position="right")            #Choose between automatically scaled x and y axis or user defined            gg_scalex = NULL            gg_scaley = NULL                gg_theme = theme_bw()    if(horizontal){    df <- as.data.frame(t(df))}plot_df <- dfif(group_type %in% "no_groups"){    groups <- FALSE}else{    plot_df$group <- group_feature    group_name <- "group"}if(circles %in% "no"){    circles_boolean <- FALSE}plot_mat <- dfif(transform == "log2"){    plot_mat <- log2(plot_mat)    cat("\n ", transform, " transformed")}else if(transform == "log2plus1"){    plot_mat <- log2(plot_mat+1)    cat("\n ", transform, " transformed")}else if(transform == "log10"){    plot_mat <- log10(plot_mat)    cat("\n ", transform, " transformed")}else if(transform == "log10plus1"){    plot_mat <- log10(plot_mat+1)    cat("\n ", transform, " transformed")}else{    plot_mat <- plot_mat}if(groups){    if(circles_boolean){        plot_out <- autoplot(prcomp(plot_mat), data = plot_df, colour = group_name,        frame = T, frame.type=circles, shape = plot_options[1],        label = plot_options[2])    }else{        plot_out <- autoplot(prcomp(plot_mat), data = plot_df, colour = group_name,        frame = F, shape = plot_options[1], label = plot_options[2])    }}else{    if(!circles_boolean){        plot_out <- autoplot(prcomp(plot_mat), data = plot_df, frame = F, shape = plot_options[1], label = plot_options[2])    }else{        plot_out <- autoplot(prcomp(plot_mat), data = plot_df, frame = F, shape = plot_options[1], label = plot_options[2])    }}plot_out <- plot_out +    scale_color_manual(values=default_ggplot_colors) +    scale_fill_manual(values=default_ggplot_colors) +    gg_theme +    gg_legend +    ggtitle('') +    theme(plot.title = element_text(hjust = 0.5))        gg_width <- as.double('7.0')        gg_height <- as.double('7.0')        gg_unit <- 'in'        gg_dpi <- as.double('300.0')        gg_add_device <- 'pdf'        output1 <- '/galaxy/server/database/jobs_directory/000/314/outputs/dataset_40b64808-14e2-4a49-acdc-322c96e921fa.dat'        output2 <- '/galaxy/server/database/jobs_directory/000/314/outputs/dataset_b46238d4-8b28-47c0-a6bf-41409b2176e7.dat'        ggsave(filename = output1, plot = plot_out, width = gg_width, height = gg_height, units = gg_unit, dpi = gg_dpi, device = "png")        if(gg_add_device != "none"){          ggsave(filename = output2, plot = plot_out, width = gg_width, height = gg_height, units = gg_unit, dpi = gg_dpi, device = gg_add_device)        }            color_names:  group1 group2 no_groupdefault_ggplot_colors:  #F8766D #00BA38 #619CFFdefault_ggplot_colors:  #F8766D #00BA38 #619CFFdefault_ggplot_colors:  #619CFF #00BA38 #F8766D
            ]]></system-out>
