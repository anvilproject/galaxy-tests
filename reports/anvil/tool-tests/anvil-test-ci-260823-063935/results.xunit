            options(show.error.messages=F, error=function(){cat(geterrmessage(), file=stderr()); q("no",1,F)})loc <- Sys.setlocale("LC_MESSAGES", "en_US.UTF-8")library("RColorBrewer")library("gplots")input <- read.delim('/galaxy/server/database/files/002/dataset_2731.dat', sep='\t', header=TRUE)mat_input <- data.matrix(input[,2:ncol(input)])rownames(mat_input) <- input[,1]    linput <- mat_input    scale <- "column"srtCol <- 30    rlabs <- NULL    clabs <- NULL    label_margins <- c(8,8)    dendrogramtoplot <- "both"        reorder_cols <- TRUE        reorder_rows <- TRUE        layout_matrix <- rbind(c(4,3), c(2,1))        key_margins <- list(mar=c(4,0.5,2,1))        lheight <- c(1, 5)        lwidth <- c(1,3)    hclust_fun <- function(x) hclust(x, method='complete')        dist_fun <- function(x) as.dist(1 - cor(t(x), method="spearman"))ncolors <- 50    colused <- colorRampPalette(c("#0000ff", "#ffffff", "#ff0000"))(ncolors)    png(file='/galaxy/server/database/jobs_directory/001/1985/outputs/dataset_cdf6945a-d8cb-4018-a669-3306e3f5c034.dat', res=240, height=2000, width=2000)heatmap.2(linput, dendrogram=dendrogramtoplot, Colv=reorder_cols, Rowv=reorder_rows,    distfun=dist_fun, hclustfun=hclust_fun, scale = scale, labRow = rlabs, labCol = clabs,    col=colused, trace="none", density.info = "none", margins=label_margins,    main = '', cexCol=0.8, cexRow=0.8, srtCol=srtCol,    keysize=3, key.xlab='', key.title='', key.par=key_margins,    lmat=layout_matrix, lhei=lheight, lwid=lwidth)dev.off()        null device           1 
